[project]
name = "{{ service_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.14,<3.15"
dependencies = [
    "fastapi>=0.142.0",
    # Loads any MLflow model flavour through pyfunc; add your framework (scikit-learn,
    # lightgbm, ...) so the model can be unpickled.
    "mlflow-skinny>=3.16.1",
    "pandas>=3.0.6",
    "prometheus-client>=0.26.0",
    "pydantic-settings>=2.15.0",
    "uvicorn[standard]>=0.54.0",
]

[dependency-groups]
dev = ["httpx2>=2.13.1", "mypy>=2.3.1", "pytest>=9.1.1", "ruff>=0.16.9"]

[build-system]
requires = ["uv_build>=0.12.20,<0.13"]
build-backend = "uv_build"

[tool.ruff]
line-length = 100
target-version = "py314"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "SIM", "N", "RUF"]

[tool.mypy]
python_version = "3.14"
ignore_missing_imports = true
check_untyped_defs = true

[tool.pytest.ini_options]
addopts = "-ra"
