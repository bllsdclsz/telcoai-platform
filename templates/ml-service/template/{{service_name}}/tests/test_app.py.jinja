import time
from collections.abc import Callable
from typing import Any

from fastapi.testclient import TestClient

from {{ package_name }}.app import LoadedModel, create_app
from {{ package_name }}.config import Settings


class DoubleIt:
    """Stand-in model: predicts twice the value of column x."""

    def predict(self, df: Any) -> Any:
        return df["x"] * 2


class FakeRegistry:
    """Stands in for the MLflow alias: ``version`` is what the alias points to (None: unset)."""

    def __init__(self, version: str | None) -> None:
        self.version, self.down = version, False

    def probe(self) -> str:
        if self.down or self.version is None:
            raise ConnectionError("registry unavailable")
        return self.version

    def load(self) -> LoadedModel:
        return LoadedModel(DoubleIt(), self.probe())


def client(registry: FakeRegistry) -> TestClient:
    settings = Settings(model_refresh_seconds=0.02)
    return TestClient(create_app(settings, loader=registry.load, version_probe=registry.probe))


def wait_for(check: Callable[[], bool], timeout: float = 3.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if check():
            return True
        time.sleep(0.02)
    return False


def test_predict_returns_model_output_and_version() -> None:
    with client(FakeRegistry("3")) as c:
        resp = c.post("/predict", json={"records": [{"x": 1}, {"x": 5}]})
    assert resp.status_code == 200
    assert resp.json() == {"model_version": "3", "predictions": [2, 10]}


def test_empty_batch_is_rejected() -> None:
    with client(FakeRegistry("3")) as c:
        assert c.post("/predict", json={"records": []}).status_code == 422


def test_unready_until_a_model_is_promoted() -> None:
    registry = FakeRegistry(None)
    with client(registry) as c:
        assert c.get("/livez").status_code == 200
        assert c.get("/health").status_code == 503
        assert c.post("/predict", json={"records": [{"x": 1}]}).status_code == 503
        registry.version = "1"
        assert wait_for(lambda: c.get("/health").status_code == 200)


def test_follows_the_alias_and_survives_a_registry_outage() -> None:
    registry = FakeRegistry("1")
    with client(registry) as c:
        registry.version = "2"
        assert wait_for(lambda: c.get("/health").json().get("model_version") == "2")
        registry.down = True
        time.sleep(0.1)
        assert c.get("/health").json() == {"status": "ok", "model_version": "2"}
        assert 'service_model_info{alias="prod",model_version="2"} 1.0' in c.get("/metrics").text
