name: {{ service_name }}-ci

on:
  push:
    branches: [main]
    paths: ["{{ service_name }}/**", ".github/workflows/{{ service_name }}-ci.yml"]
  pull_request:
    paths: ["{{ service_name }}/**", ".github/workflows/{{ service_name }}-ci.yml"]

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

defaults:
  run:
    working-directory: {{ service_name }}

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          enable-cache: true
          working-directory: {{ service_name }}
      - run: uv sync --locked
      - run: uv run ruff check . && uv run ruff format --check .
      - run: uv run mypy src
      - run: uv run pytest

  # Pull requests only build the image; main also publishes it (tags: main, sha-<commit>).
  image:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    env:
      PUBLISH: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
      - if: env.PUBLISH == 'true'
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: {{ service_name }}
          push: {% raw %}${{ env.PUBLISH == 'true' }}{% endraw %}
          tags: |
            ghcr.io/{{ github_owner }}/{{ service_name }}:main
            ghcr.io/{{ github_owner }}/{{ service_name }}:sha-{% raw %}${{ github.sha }}{% endraw %}
          labels: org.opencontainers.image.source={% raw %}${{ github.server_url }}/${{ github.repository }}{% endraw %}
          cache-from: type=gha,scope={{ service_name }}
          cache-to: type=gha,mode=max,scope={{ service_name }}
